# Copy to .env for local development. Every value here has a working default
# in settings.py, so an empty .env still boots.

DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres
POSTGRES_DB=splitstock
POSTGRES_USER=splitstock
POSTGRES_PASSWORD=splitstock
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Managed hosts (Railway) set DATABASE_URL instead, which wins over the above.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Redis powers both the Channels layer and the Celery broker.
REDIS_URL=redis://127.0.0.1:6379/0

# Where the Vite dev server runs.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173

# Leave Twilio blank locally — alerts are logged instead of sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

PREDICTION_WINDOW_DAYS=14
